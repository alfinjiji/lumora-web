{
  "name": "auraflare",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @auraflare/web dev",
    "build": "pnpm --filter @auraflare/web build",
    "lint": "pnpm --filter @auraflare/web lint",
    "typecheck": "pnpm -r typecheck",
    "contract:generate": "node scripts/contract.mjs generate && openapi-typescript contracts/openapi.yaml -o packages/api-client/src/schema.d.ts",
    "contract:validate": "redocly lint contracts/openapi.yaml",
    "test:web": "bash scripts/test-browser.sh",
    "test:e2e": "pnpm exec playwright test",
    "pnpm": "pnpm",
    "contract:check": "node scripts/contract.mjs check",
    "contract:examples": "node scripts/contract.mjs examples",
    "format:check": "prettier --check apps/web/src apps/web/next.config.ts packages/api-client/src/index.ts scripts/contract.mjs tests/browser playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@redocly/cli": "2.65.0",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.2",
    "yaml": "2.8.3"
  }
}
