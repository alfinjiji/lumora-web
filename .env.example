# Use .env.local for local development; never commit real credentials.
# Supply raw server-side values. Signature verification needs the real secret,
# rather than a network-proxy placeholder. Never use a VITE_ prefix for secrets.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: enable payment.captured webhooks for callback recovery.
RAZORPAY_WEBHOOK_SECRET=
# Keep false until the catalog, delivery, taxes, and fulfilment are confirmed.
AURAFLARE_STORE_LIVE=false
# Product prices are treated as tax-inclusive; confirm before launch.
AURAFLARE_SHIPPING_INR=0
# SQLite order records include delivery details; protect and back up this folder.
AURAFLARE_DATA_DIR=.data
PORT=3001
